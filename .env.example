# Copier ce fichier en .env (jamais committé) puis remplir.

# --- LLM ------------------------------------------------------------------
# fake = réponses scriptées (tests, CI) ; openai_compatible = tout fournisseur
# exposant POST {LLM_BASE_URL}/chat/completions (cloud, OpenRouter, vLLM ou
# Ollama sur Colab derrière le tunnel).
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
# routeur, vérificateur (rapide, peu cher)
LLM_MODEL_SMALL=
# réponse RAG, rédaction, vision
LLM_MODEL_LARGE=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Modèle de secours si le principal échoue (ex. autre fournisseur)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Agents ---------------------------------------------------------------
# heuristic | llm
ROUTER_MODE=heuristic

# --- API ------------------------------------------------------------------
# Obligatoire dès que l'API est exposée par un tunnel (n8n envoie X-API-Token)
API_TOKEN=change-moi

# --- Suivi ----------------------------------------------------------------
TRACE_PATH=logs/traces.jsonl
BUDGET_USD=20

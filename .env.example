# Copier ce fichier en .env (jamais committé) puis remplir.

# --- LLM ------------------------------------------------------------------
# fake = réponses scriptées (tests, CI) ; openai_compatible = tout fournisseur
# exposant POST {LLM_BASE_URL}/chat/completions (cloud, OpenRouter, vLLM ou
# Ollama sur Colab derrière le tunnel).
# Exemple Groq (gratuit, voir README) :
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL_SMALL=openai/gpt-oss-20b
#   LLM_MODEL_LARGE=openai/gpt-oss-120b
#   LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
# routeur, vérificateur (rapide, peu cher)
LLM_MODEL_SMALL=
# réponse RAG, rédaction, vision
LLM_MODEL_LARGE=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Modèle de secours si le principal échoue (ex. autre fournisseur)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Agents ---------------------------------------------------------------
# heuristic | llm
ROUTER_MODE=heuristic

# --- RAG ------------------------------------------------------------------
# A (taille fixe) | B (par paragraphe, recommandé)
RAG_STRATEGY=B
# bm25 | dense | hybrid (dense et hybrid exigent : python -m rag.build_index --dense)
# hybrid + glossaire = meilleure configuration mesurée (D-017) ; bm25 si l'index dense n'est pas construit
RAG_MODE=hybrid
# modèle de l'index dense (doit correspondre à l'index construit) ; vide uniquement en mode bm25
RAG_EMBED_MODEL=BAAI/bge-m3
# 1 = ajoute les termes officiels (CSM → marge sur services contractuels…)
RAG_GLOSSARY=1
# Version du prompt de l'agent RAG (2 = retenue, 1 = ancienne ; voir D-024)
# 1 = le LLM reformule la question dans les mots de la norme avant la recherche (D-045)
RAG_REWRITE=0
# Recherche avancée (D-048 à D-050) : chaque option est mesurée avant d'être activée
# Stockage des vecteurs (D-052) : numpy (fichier en mémoire) ou qdrant (base vectorielle).
# Qdrant embarqué si QDRANT_URL est vide ; serveur Docker : QDRANT_URL=http://localhost:6333 (docker-compose.yml)
RAG_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
# reranker (D-053, D-054) : utile en recherche simple sur carte graphique (BAAI/bge-reranker-v2-m3) ;
# pas de gain avec l'agent LangGraph, donc vide dans la configuration retenue
RAG_RERANK_MODEL=
# configuration retenue (D-051) : agent LangGraph seul. Mode rapide sans LLM pour la recherche :
# RAG_AGENTIC=0, RAG_QUESTIONS=1, RAG_GRAPH=1 (demande `python -m rag.qindex --model BAAI/bge-m3`)
RAG_QUESTIONS=0
RAG_GRAPH=0
RAG_AGENTIC=1
RAG_PROMPT_VERSION=2

# --- API ------------------------------------------------------------------
# Obligatoire dès que l'API est exposée par un tunnel (n8n envoie X-API-Token)
API_TOKEN=change-moi

# --- Suivi ----------------------------------------------------------------
TRACE_PATH=logs/traces.jsonl
BUDGET_USD=20

# --- Vision (lecture d'images de documents) --------------------------------
# Clé gratuite : https://aistudio.google.com → Get API key. Les données du niveau gratuit
# peuvent servir à Google : n'envoyer que des documents fictifs.
GEMINI_API_KEY=
VISION_MODEL=gemini-3.8-flash
VISION_FALLBACK_MODEL=gemini-3.5-flash-lite
# PDF à couche texte : texte (Groq, par défaut) ou hybride (texte + image, Gemini)
EXTRACT_PDF_MODE=texte
# Mode vision : double lecture de l'image (1 = oui), divergence → validation humaine
VISION_DOUBLE_READ=1

# --- Vérificateur (LLM-juge après l'agent RAG) ---------------------------
VERIFIER=1
VERIFIER_MAX_ROUNDS=1

# --- Voix (Whisper sur Groq, même clé que le LLM) ------------------------
SPEECH_MODEL=whisper-large-v3-turbo

# --- Réponses de référence (questions fixes de la note) -------------------
NORM_REFERENCE=1

# Validation humaine par e-mail depuis le site web (workflow n8n 06, D-041).
# Laisser vide pour ne pas envoyer d'e-mail. n8n doit tourner et le workflow ifrs17_copilot.json être actif.
N8N_VALIDATION_URL=http://127.0.0.1:5678/webhook/ifrs17/validation

# --- Note actuarielle (D-055) --------------------------------------------
# Entité affichée en page de garde de la note
NOTE_ENTITY=Compagnie d'assurance fictive (projet pédagogique)
# Coefficient de variation supposé des sorties : sert à calculer le niveau de confiance de l'ajustement pour risque (D-056)
RA_CV=0.15

# --- Registre, audit et comptes (D-058) --------------------------------------
# Base SQLite des dossiers et de la piste d'audit (hors Git)
REGISTRY_PATH=data/registry.db
# Premier compte administrateur, créé au démarrage si aucun compte n'existe.
# Autres comptes : python -m core.registry add-user <nom> --role analyste|valideur|admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Copilot (D-061) : état du graphe LangGraph sauvegardé après chaque étape (reprise, rejeu)
COPILOT_CHECKPOINTS=data/copilot_checkpoints.db

# Dossier (D-063) : questions à la norme en parallèle. Mesuré sans gain sur l'offre gratuite de Groq
# (quota de jetons par minute) : 1 = l'une après l'autre. Essayer 3 avec une offre payante.
NORM_PARALLEL=1

# Note en PDF (D-065) : jointe aux e-mails par n8n. Vide = Edge, Chrome ou Chromium trouvé automatiquement.
# Sinon le chemin complet, par exemple : C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
NOTE_PDF_BROWSER=

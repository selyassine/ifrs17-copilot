{
  "name": "07 — Réception des dossiers par e-mail (IMAP)",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "format": "simple",
        "downloadAttachments": true,
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "customEmailConfig": "[\"UNSEEN\", [\"SUBJECT\", \"IFRS17\"]]"
        }
      },
      "id": "c44fc9b1-4a8c-56fb-9f83-902166795e5b",
      "name": "E-mail reçu (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Un élément par pièce jointe exploitable (PDF, PNG, JPEG) ; un e-mail sans document est signalé.\nconst ACCEPTE = ['application/pdf', 'image/png', 'image/jpeg'];\nconst adresse = de => (String(de || '').match(/[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+/) || [''])[0].toLowerCase();\nconst sortie = [];\nfor (const mail of $input.all()) {\n  const deposant = adresse(mail.json.from);\n  const pieces = Object.entries(mail.binary || {}).filter(([, b]) => ACCEPTE.includes(b.mimeType));\n  if (!pieces.length) {\n    sortie.push({ json: { sans_document: true, deposant, sujet: mail.json.subject || '' } });\n    continue;\n  }\n  for (const [, b] of pieces) {\n    sortie.push({ json: { source: 'n8n-email', deposant, sujet: mail.json.subject || '', nom_fichier: b.fileName || 'document' },\n                  binary: { document: b } });\n  }\n}\nreturn sortie;\n"
      },
      "id": "5abfd0cc-e6a3-5cac-8806-3e0f23f7b33f",
      "name": "Extraire les documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "2a61cb66-8100-50ba-8d2a-fa37507ab530",
              "leftValue": "={{ $json.sans_document === true }}",

      ]
    },
    {
      "parameters": {
        "jsCode": "// À ADAPTER : les seuls réglages du workflow. Le jeton reste « change-moi » dans le fichier\n// commité ; mettez la valeur d'API_TOKEN dans n8n. Utilisé pour répondre aux e-mails sans document.\nconst parametres = {\n  valideur: 'votre.adresse@gmail.com',             // reçoit les alertes et les dossiers à valider\n  expediteur: 'Copilote IFRS 17 <votre.adresse@gmail.com>',  // l'adresse du compte SMTP\n  api: 'http://127.0.0.1:8000',\n  jeton: 'change-moi',\n};\nreturn $input.all().map(i => ({ json: { ...i.json, parametres } }));\n"
      },
      "id": "28f17141-5007-57d4-acb6-4abfae2e1c6b",
      "name": "Paramètres",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Paramètres').item.json.parametres.expediteur }}",
        "toEmail": "={{ $json.deposant }}",
        "subject": "=Re: {{ $json.sujet }} · aucun document joint",
        "emailFormat": "text",
        "text": "=Bonjour,\n\nVotre e-mail ne contient pas de document exploitable. Joignez l'état du portefeuille en PDF, PNG ou JPEG et gardez « IFRS17 » dans l'objet.",

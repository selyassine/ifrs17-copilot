        "jsCode": "// À ADAPTER : les seuls réglages du workflow. Le jeton reste « change-moi » dans le fichier\n// commité ; mettez la valeur d'API_TOKEN dans n8n. Sous-workflow : appelé par 07 (e-mail) et 08 (formulaire), un élément par document.\nconst parametres = {\n  valideur: 'votre.adresse@gmail.com',             // reçoit les alertes et les dossiers à valider\n  expediteur: 'Copilote IFRS 17 <votre.adresse@gmail.com>',  // l'adresse du compte SMTP\n  api: 'http://127.0.0.1:8000',\n  jeton: 'change-moi',\n  validation: 'http://127.0.0.1:5678/webhook/ifrs17/validation',  // workflow 06 (activé)\n};\nreturn { json: { ...$input.item.json, parametres }, binary: $input.item.binary };\n"
      },
